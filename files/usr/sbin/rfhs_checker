#!/bin/ash
# shellcheck shell=busybox
# RFHS checker script for realtime troubleshooting, status checking, and CI/CD
# check for ssid's and services working

set -eu

status_dir='/root/shared_persistent_storage'
[ ! -d "${status_dir}" ] && mkdir -p "${status_dir}"
# Write to a tmpdir and move it into place after finishing creating the file content
apstatus="$(mktemp)"
apstatusfinal="${status_dir}/AP_status"

# printf to the screen and the status file
say() {
  # shellcheck disable=SC2059
  printf "$@"
  # shellcheck disable=SC2059
  printf "$@" >> "${apstatus}"
}

say "# This file is auto generated once per minute (ideally) and NEVER read by anything\n"
say '# Last generation start time %s (compare to "date" command)\n' "$(date)"

fail_count=0
if [ "${1:-}" = "excessive" ]; then
  excessive=1
else
  excessive=0
fi
if [ "${1:-}" = "bootwifi" ]; then
  bootwifi=1
else
  bootwifi=0
fi

# sets waited=1 when it had to wait
wait_for_it() {
  iter=0
  if [ "${excessive}" = "1" ]; then
    while pgrep -f rfhs_wifi_fixer > /dev/null; do
      waited=1
      if [ "${iter}" -ge "60" ]; then
        say "Timeout waiting for rfhs_wifi_fixer to do it's job.\n"
        mv "${apstatus}" "${apstatusfinal}"
        exit 1
      fi
      say "rfhs_wifi_fixer is prepping the system...\n"
      sleep 1
      iter=$((iter + 1))
    done
  fi
  while pgrep -f mac80211.sh > /dev/null; do
    waited=1
    if [ "${iter}" -ge "60" ]; then
      say "Timeout waiting for mac80211.sh to do it's job.\n"
      mv "${apstatus}" "${apstatusfinal}"
      exit 1
    fi
    say "mac802.11.sh is configuring interfaces...\n"
    sleep 1
    iter=$((iter + 1))
  done
  while pgrep -f 'ubus call hostapd' > /dev/null 2>&1; do
    waited=1
    if [ "${iter}" -ge "60" ]; then
      say "Timeout waiting for 'ubus call hostapd to do it's job.\n"
      mv "${apstatus}" "${apstatusfinal}"
      exit 1
    fi
    say "ubus is still configuring hostapd...\n"
    sleep 1
    iter=$((iter + 1))
  done
  return 0
}

do_check() {
  check=0
  # Write status files which may or may not be used by code you will never see...
  status_files=''
  if [ -d '/run/rfctf_status' ]; then
    status_files='/run/rfctf_status'
  fi

  # Compares the configured SSIDs with the running ones as multisets, since
  # several APs can share an SSID, and prints extra:SSID, missing:SSID and
  # phy:PHY for a configured phy that is missing. iw dev gives the SSID each
  # interface is beaconing, from the kernel; iwinfo takes far longer to
  # print everything about every interface. iw finds phys by name the same
  # way, in /sys/class/ieee80211, which only shows the phys in this network
  # namespace. Opening a status file for writing updates its mtime, as touch
  # did.
  problems="$(iw dev | awk -v status_files="${status_files}" '
    BEGIN {
      while ((getline line < "/etc/config/wireless") > 0) {
        if (line ~ /^#/) continue
        gsub("\047", "", line)
        split(line, f)
        if (line ~ / ssid /) {
          ssids[f[3]]++
        } else if (line ~ / phy /) {
          index_file = "/sys/class/ieee80211/" f[3] "/index"
          if ((getline x < index_file) < 0) print "phy:" f[3]
          close(index_file)
        }
      }
    }
    $1 == "ssid" {
      ssids[$2]--
      if (status_files != "" && !($2 in written)) {
        written[$2] = 1
        status_file = status_files "/" $2 "_ap_running"
        printf "" > status_file
        close(status_file)
      }
    }
    END {
      for (s in ssids) {
        if (s ~ /unknown|OpenWrt/) continue
        for (i = ssids[s]; i > 0; i--) print "missing:" s
        for (i = ssids[s]; i < 0; i++) print "extra:" s
      }
    }')"

  if [ -n "${problems}" ]; then
    check=1
    for problem in $(printf '%s\n' "${problems}" | sort); do
      name="${problem#*:}"
      case "${problem}" in
        extra:*)
          say '%s is running but not configured???\n' "${name}"
          iwinfo | grep -A1 -- "${name}" | tee -a "${apstatus}"
          ;;
        missing:*)
          say '%s is configured but not running\n' "${name}"
          say '\nUCI CONFIG:\n'
          grep -v '^#' /etc/config/wireless | grep -A1 -- " ssid .${name}" | tee -a "${apstatus}"
          say '\nHOSTAPD Config:\n'
          awk "/^ssid=${name}/{print FILENAME}" /var/run/*.conf | tee -a "${apstatus}"
          say '\nRUNNING:\n'
          iwinfo | grep -A2 -- "${name}" | tee -a "${apstatus}"
          say "-------------------------------------------\n"
          ;;
        phy:*)
          say '%s is configured but missing\n' "${name}"
          ;;
      esac
    done
  fi
  if [ "${check}" = "0" ]; then
    say 'AP Status: Running config matches written config\n'
    say 'Wifi is UP\n'
  else
    if pgrep -f mac80211.sh > /dev/null 2>&1; then
      check=1
      say '-------------------------------------------\n'
      say "OpenWRT is still has mac80211.sh configuration processes running.\n"
    fi
  fi
  return "${check}"
}

check_services() {
  service_check=0
  # Checking for pop3, and dhcp, but NOT dns or https because those bind to ip not all
  listening=" $(ss -Hnltu | awk '{ printf "%s/%s ", $1, $5 }')"
  for socket in tcp/0.0.0.0:110 udp/0.0.0.0:67; do
    case "${listening}" in
      *" ${socket} "*) ;;
      *)
        say 'Nothing is listening on %s port %s\n' "${socket%%/*}" "${socket##*:}"
        service_check=1
        ;;
    esac
  done
  if [ "${service_check}" != "0" ]; then
    ss -nltup | tee -a "${apstatus}"
  fi
  return "${service_check}"
}

if [ -f '.dockerenv' ]; then
  boot_timestamp="$(stat -c %Y /.dockerenv)"
  target_time=$(( 30 + boot_timestamp ))
  sleepy_tyme=$(( target_time - $(date +%s) ))
else
  # not in docker, assume uptime is when we booted
  sleepy_tyme=$(( 60 - $(awk -F. '{print $1}' /proc/uptime) ))
fi
if [ "${sleepy_tyme}" -gt "0" ]; then
  if [ "${sleepy_tyme}" -gt "60" ]; then
    #if the time skews during/after boot this number can end up huge
    #limit it to the a sane maximum
    sleepy_tyme=60
    #time looks skewed, so fix it for the next run
    #this will make the loop always think it's in docker but also not sleep every time it runs
    touch .dockerenv
  fi
  say 'Sleeping for %ss while system is booting...\n' "${sleepy_tyme}"
  sleep "${sleepy_tyme}"
fi

if [ "${excessive}" = "1" ]; then
  for required_command in rfhs_predictable_phys grep sort iw sed xargs wc lsmod rmmod; do
    if [ ! -x "$(command -v ${required_command} 2>&1)" ]; then
      say "Missing required command: %s\n" "${required_command}"
      fail_count=$((fail_count + 1))
    fi
  done
  for rfhs_command in iptables cat ip fakepop ss; do
    if [ ! -x "$(command -v ${rfhs_command} 2>&1)" ]; then
      say "Missing rfhs command: %s\n" "${rfhs_command}"
      fail_count=$((fail_count + 1))
    fi
  done
fi
waited=0
wait_for_it
# one configuration step can start right after another finished
if [ "${waited}" = "1" ]; then
  sleep 1
  wait_for_it
fi
if do_check; then
  say "Check Pass\n"
else
  say "Check Failed\n"
  fail_count=$((fail_count + 1))
fi

# If we found something wrong
if [ "${fail_count}" -gt "0" ]; then
  # and we are doing a normal check
  if [ "${excessive}" = "0" ]; then
    # Kick the wifi to see if it recovers.
    say "Failures found, restarting wifi to attempt auto recovery...\n"
    wifi up
    say "Wifi restart triggered, run rfhs_checker again in 60s...\n"
  fi
fi

# Add a check for setageing?

if [ "${bootwifi}" = "0" ]; then
  if check_services; then
    say 'Service Check Pass\n'
  else
    say 'Service Check Failed\n'
    fail_count=$((fail_count + 1))
  fi
fi

say 'Checker run completed\n'
# Move the file into place right before exiting
mv "${apstatus}" "${apstatusfinal}"
if [ "${fail_count}" -gt "0" ]; then
  exit 1
fi
