config dnsmasq
	option domainneeded '1'
	option authoritative '1'
	option local '/lan/'
	option domain 'lan'
	option localservice '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config dhcp 'Admin42'
	option interface 'Admin42'
	option start '100'
	option limit '100'
	option leasetime '1h'
	option force '1'

config dhcp 'lan10'
	option interface 'lan10'
	option start '100'
	option limit '100'
	option leasetime '1h'
	option force '1'

config dhcp 'lan20'
	option interface 'lan20'
	option start '100'
	option limit '100'
	option leasetime '1h'
	option force '1'

config dhcp 'lan30'
	option interface 'lan30'
	option start '100'
	option limit '100'
	option leasetime '1h'
	option force '1'
