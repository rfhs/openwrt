	option name 'lan10'
	option network 'lan10'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

config forwarding
	option src 'lan10'
	option dest 'wan'

config forwarding
	option src 'Admin42'
	option dest 'lan10'

config rule
	option name 'Allow lan10 DHCP'
	option src 'lan10'
	option proto 'udp'
	option dest_port '67'
	list dest_ip '255.255.255.255'
	list dest_ip '172.16.10.1'
	option target 'ACCEPT'

config rule
	option name 'Allow lan10 DNS'
	option src 'lan10'
	option proto 'tcp udp'
	option dest_port '53'
	option dest_ip '172.16.10.1'
	option target 'ACCEPT'

config rule
	option name 'Allow lan10 ping'
	option src 'lan10'
	option proto 'icmp'
	option dest_ip '172.16.10.1'
	option target 'ACCEPT'

